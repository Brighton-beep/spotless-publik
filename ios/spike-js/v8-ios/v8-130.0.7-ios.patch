   }
+  // iOS (spike S3): no Linux sysroot; tell GN the OS + environment.
+  if target_os == "ios" {
+    let target_triple = env::var("TARGET").unwrap();
+    gn_args.push(r#"target_os="ios""#.to_string());
+    gn_args.push(r#"target_cpu="arm64""#.to_string());
+    gn_args.push(r#"v8_target_cpu="arm64""#.to_string());
+    if target_triple.ends_with("-sim") {
+      gn_args.push(r#"target_environment="simulator""#.to_string());
+    } else {
+      gn_args.push(r#"target_environment="device""#.to_string());
+    }
+    gn_args.push("ios_enable_code_signing=false".to_string());
+    gn_args.push("treat_warnings_as_errors=false".to_string());
+  } else
   // cross-compilation setup
