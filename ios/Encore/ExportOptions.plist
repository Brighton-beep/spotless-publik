<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App Store Connect export for the iPhone app: `xcodebuild -exportArchive` signs the archive for
  distribution and uploads it (destination upload), so no altool/Transporter step follows.
  teamID is left empty on purpose (the public snapshot carries no team ID); fill it in before use:
    plutil -replace teamID -string <TEAMID> <copy of this file>
  .github/workflows/release-ios.yml does that on a copy in the runner's temp folder.
  manageAppVersionAndBuildNumber is off: the build number is CURRENT_PROJECT_VERSION in
  project.yml, which the ios-v<version>-<build> tag is checked against.
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string></string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
